# Supabase — copy this file to `.env` and fill in your project values.
# The anon (publishable) key is safe to expose in the browser; it is protected
# by your Row Level Security policies. Do NOT put the service_role key here.
#
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Store contact / payment (shown on the checkout screen)
VITE_WHATSAPP_NUMBER="2347035270914"
VITE_BANK_NAME="FCMB"
VITE_BANK_ACCOUNT_NAME="Inioluwa"
VITE_BANK_ACCOUNT_NUMBER="0000000000"

# NOTE: If the Supabase vars are omitted, the app falls back to the bundled
# seed catalog in src/data/products.ts so it still runs out of the box.
